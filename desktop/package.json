{
  "name": "fri-desktop",
  "productName": "FRI",
  "version": "0.8.2",
  "description": "A local calendar with a native glass workspace.",
  "author": "FRI contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:ui": "node prepare.cjs",
    "start": "npm run prepare:ui && electron .",
    "test": "node --test --test-concurrency=1 meeting-agent.test.cjs desktop.test.cjs keyboard.test.cjs widget-persistence.test.cjs core.test.cjs planning.test.cjs widget.test.cjs brand.test.cjs ai-import.test.cjs network.test.cjs source-browser.test.cjs day.test.cjs day.integration.test.cjs updates.test.cjs document-text.test.cjs scripts/mac-release.test.cjs",
    "pack": "npm run prepare:ui && electron-builder --dir",
    "dist": "node scripts/dist.cjs",
    "dist:mac:development": "node scripts/build-mac.cjs --development",
    "verify:mac": "node scripts/verify-mac.cjs"
  },
  "dependencies": {
    "@hicccc77/electron-liquid-glass": "0.3.0",
    "@tesseract.js-data/vie": "1.0.0",
    "electron-updater": "6.8.11",
    "koffi": "3.3.8",
    "leaflet": "1.9.4",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.fri.calendar",
    "productName": "FRI",
    "directories": {
      "output": "../dist",
      "buildResources": "resources"
    },
    "files": [
      "*.cjs",
      "!*.test.cjs",
      "!.env*",
      "!day.env",
      "widget*.html",
      "ui/**/*",
      "resources/icon.png",
      "package.json",
      "ocr.ps1",
      "maps.html",
      "maps-renderer.js",
      "widget.css",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/build/**/*",
      "!node_modules/pdfjs-dist/web/**/*",
      "!node_modules/pdfjs-dist/legacy/web/**/*",
      "!node_modules/pdfjs-dist/types/**/*",
      "!node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!node_modules/pdfjs-dist/legacy/build/pdf.sandbox*",
      "!node_modules/pdfjs-dist/legacy/build/pdf.renderer*",
      "usage-guide.html",
      "usage-guide.js",
      "meeting-agent.html",
      "meeting-view.js",
      "!node_modules/@tesseract.js-data/vie/4.0.0/**/*",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "meeting-prompt.html",
      "meeting-prompt-view.js"
    ],
    "asar": true,
    "artifactName": "FRI-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "dakiemdarktharr",
        "repo": "FRI",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "FRI"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "hardenedRuntime": true
    },
    "asarUnpack": [
      "ocr.ps1",
      "node_modules/@hicccc77/electron-liquid-glass/**/*",
      "node_modules/{tesseract.js,tesseract.js-core,wasm-feature-detect,regenerator-runtime,bmp-js,zlibjs,is-url}/**/*",
      "node_modules/@tesseract.js-data/vie/4.0.0_best_int/*"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "en-GB"
    ]
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
