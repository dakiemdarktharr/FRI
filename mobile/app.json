{
  "expo": {
    "name": "Fri",
    "slug": "fri",
    "version": "0.4.1",
    "scheme": "fri",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.fri.calendar.android",
      "versionCode": 5,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F4F7FA"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      "./plugins/with-fri.cjs",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "BeVietnamPro",
                "fontDefinitions": [
                  {
                    "path": "../brand/fonts/be-vietnam-pro/BeVietnamPro-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "../brand/fonts/be-vietnam-pro/BeVietnamPro-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "../brand/fonts/be-vietnam-pro/BeVietnamPro-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
